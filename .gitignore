.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
# Toprope's working state stays local, except the domain commit store: commits, branches,
# approvals and check records are decisions, shared and audited through git (decided 2026-11-06).
.toprope/*
!.toprope/commits/
!.toprope/requests/
!.toprope/approval-runs.jsonl
# Commands that failed before the gate, one file each (ADR-0049, D1b): usage data for F1.
!.toprope/failures/
.toprope/commits/**/.lock
.toprope/commits/**/.obj-*
.toprope/commits/**/.refs-*
# Each domain's event log (domains/<domain>/events) is kept in git; its lock is not.
domains/*/events/.lock
.toprope/commits/**/merging.json
